import { Palette } from "std-widgets.slint";
import { WindowsContrast } from "system-colors.slint";

export component SettingsCard inherits Rectangle {
    in property <string> title;
    property <bool> dark: Palette.background.to-hsv().value < Palette.foreground.to-hsv().value;
    background: WindowsContrast.colors.active ? Palette.alternate-background : root.dark ? #ffffff10 : #ffffffb8;
    border-radius: WindowsContrast.colors.active ? 0px : 8px;
    border-width: 1px;
    border-color: WindowsContrast.colors.active ? Palette.foreground : root.dark ? #ffffff0c : #00000012;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        if !root.title.is-empty: Text {
            text: root.title;
            font-size: 16px;
            font-weight: 600;
            color: Palette.foreground;
            wrap: word-wrap;
        }
        @children
    }
}
