<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestPatch</RollForward>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <AssemblyName>McpLocal.Desktop</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DesktopBuildManifest)')">
    <EmbeddedResource Include="$(DesktopBuildManifest)" LogicalName="desktop-build.json" />
  </ItemGroup>
</Project>
